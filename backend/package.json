{
  "name": "express",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/infra/http/server.ts",
    "dev:ws": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/infra/ws/server.ts",
    "dev:persist-consumer": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/infra/persist-consumer/server.ts",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "start": "node dist/infra/http/server.js",
    "prepare": "cd .. && husky",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typeorm": "ts-node -r tsconfig-paths/register ./node_modules/typeorm/cli.js",
    "migration:generate": "yarn typeorm migration:generate -d src/infra/database/data-source.ts",
    "migration:run": "yarn typeorm migration:run -d src/infra/database/data-source.ts",
    "migration:revert": "yarn typeorm migration:revert -d src/infra/database/data-source.ts",
    "seed": "ts-node --transpile-only -r tsconfig-paths/register src/infra/database/seed/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "lint-staged": {
    "src/**/*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "amqplib": "^2.2.0",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.3.1",
    "emoji-regex": "^10.6.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "globals": "^17.4.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.20.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "tsconfig-paths": "^4.2.0",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.28",
    "uuid": "^11.1.0",
    "ws": "^8.22.0",
    "zod": "^4.3.6",
    "zod-openapi": "^6.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.6.0",
    "@testcontainers/postgresql": "10.13.2",
    "@testcontainers/rabbitmq": "10.13.2",
    "@testcontainers/redis": "10.13.2",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^25.5.0",
    "@types/supertest": "^7.2.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.4",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "supertest": "^7.2.2",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vitest": "^4.1.4"
  }
}
